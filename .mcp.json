{
  "mcpServers": {
    "afiliads": {
      "command": "node",
      "args": [
        "/Users/genautech/afiliados/mcp-afiliads/index.mjs"
      ],
      "env": {
        "DATABASE_URL": "${env:DATABASE_URL}",
        "AFILIADS_APP_URL": "https://afiliads-app-production.up.railway.app",
        "AFILIADS_MCP_TOKEN": "${env:AFILIADS_MCP_TOKEN}",
        "AFILIADS_USER_EMAIL": "genaujunior@gmail.com"
      }
    },
    "hostinger-wordpress": {
      "command": "hostinger-wordpress-mcp",
      "env": {
        "HOSTINGER_API_TOKEN": "${HOSTINGER_API_TOKEN}"
      }
    },
    "knowledge-studio": {
      "command": "node",
      "args": [
        "--no-warnings",
        "--experimental-strip-types",
        "/Users/genautech/knowledge-studio/mcp/server.ts"
      ],
      "env": {}
    }
  }
}
