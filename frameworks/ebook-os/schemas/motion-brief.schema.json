{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marca-propria.local/schema/motion-brief.json",
  "title": "Motion brief EBOOK-OS",
  "description": "Contrato opcional. Só é validado se motion-brief.yaml existir. Lottie e GSAP são incompatíveis com PDF/EPUB.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "produto",
    "superficie",
    "motores",
    "justificativa",
    "reduced_motion",
    "variant_id"
  ],
  "properties": {
    "produto": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "versao"],
      "properties": {
        "id": { "type": "string", "minLength": 3 },
        "versao": { "type": "string", "minLength": 1 }
      }
    },
    "superficie": {
      "type": "string",
      "enum": ["pdf", "epub", "pagina-hospedada"]
    },
    "motores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["css_svg", "lottie", "gsap"],
      "properties": {
        "css_svg": { "type": "boolean" },
        "lottie": { "type": "boolean" },
        "gsap": { "type": "boolean" }
      }
    },
    "justificativa": { "type": "string", "minLength": 8 },
    "reduced_motion": {
      "type": "string",
      "enum": ["obrigatorio"]
    },
    "variant_id": { "type": "string", "minLength": 3 }
  }
}
