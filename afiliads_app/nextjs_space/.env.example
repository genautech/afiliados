# Kill-switch: só true habilita qualquer mutate real na Google Ads API. Mock mode ignora esta flag.
GOOGLE_ADS_MUTATIONS_ENABLED=false
# CSV de customer IDs (sem hífen) autorizados a sofrer mutate real. Vazio = nenhuma conta autorizada.
GOOGLE_ADS_MUTATION_ALLOWLIST=

# Inteligência e Pesquisa de Mercado (Trend Scout & Ad Scout Oracle)
FIRECRAWL_API_KEY=
OPENROUTER_API_KEY=


# Camada de julgamento (TypeSafe / System One) — decisões tipadas de compliance no lugar de regex.
# Sem a chave, o app cai no caminho determinístico de sempre (lib/complianceVerifier.ts).
TYPESAFE_API_KEY=
# 1 = roda o julgamento em paralelo com a regex e loga divergência ([typesafe-shadow]) sem decidir nada.
TYPESAFE_SHADOW=0
