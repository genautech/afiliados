generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String                @id @default(cuid())
  name                 String?
  email                String                @unique
  emailVerified        DateTime?
  image                String?
  password             String?
  role                 String                @default("USER") // USER | ADMIN
  isActive             Boolean               @default(true)
  metaReceitaMensal    Float                 @default(0)
  metaRoi              Float                 @default(0)
  budgetMensalAds      Float                 @default(0)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  accounts             Account[]
  sessions             Session[]
  campaigns            Campaign[]
  dailyLogs            DailyLog[]
  keywords             Keyword[]
  decisions            CampaignDecision[]
  integrations         Integration[]
  kbSearches           KnowledgeBaseSearch[]
  offers               Offer[]
  testResults          TestResult[]
  atpSearches          AtpSearch[]
  productResearch      ProductResearch[]
  agentRuns            AgentRun[]
  Presell              Presell[]
  usagePayments        UsagePayment[]
  marketIntelSnapshots MarketIntelSnapshot[]
  checklistLearnings   ChecklistLearning[]
  googleAdsExperiments GoogleAdsExperiment[]
  marketResearches     MarketResearch[]
  brandKits            BrandKit[]
  offerDesigns         OfferDesign[]
  claimLedger          ClaimLedgerEntry[]
  contentArchitectures ContentArchitecture[]
  copyQaReports        CopyQaReport[]
  visualSystems        VisualSystem[]
  launchPlans          LaunchPlan[]
  channelLaunches      ChannelLaunch[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Campaign {
  id                    String    @id @default(cuid())
  userId                String
  productResearchId     String?
  name                  String
  platform              String
  vertical              String
  geo                   String
  channel               String
  funnel                String    @default("BRIDGE")
  status                String    @default("EM_TESTE")
  offerUrl              String?   @db.Text
  commission            Float     @default(0)
  refundPct             Float     @default(0)
  aov                   Float     @default(0)
  cvrExpected           Float     @default(1.0)
  commissionNet         Float     @default(0)
  epcBreakeven          Float     @default(0)
  cpcMax                Float     @default(0)
  cpcScale              Float     @default(0)
  presellUrl            String?   @db.Text
  presellGeneratedAt    DateTime?
  flowpageUrl           String?   @db.Text
  hostingerDomain       String?
  budgetTest            Float     @default(50)
  budgetDaily           Float     @default(0)
  testDuration          String    @default("72h")
  budgetScale           Float     @default(0)
  campaignNameGenerated String?
  utmString             String?   @db.Text
  googleCampaignName    String?
  googleCampaignId      String?
  googleAdGroupId       String?
  // IDs remotos do Meta Ads. Presença = fronteira externa já cruzada; a
  // idempotência do Painel de Lançamento se apoia nisso, igual ao Google.
  metaCampaignId        String?
  metaAdSetId           String?
  metaAdId              String?
  campaignType          String?
  bidStrategy           String?
  utmCampaign           String?
  qualityScoreNotes     String?
  postbackUrl           String?   @db.Text
  clickidToken          String?
  presellHtml           String?   @db.Text
  pageType              String    @default("advertorial")
  popupGate             Boolean   @default(false)
  videoUrl              String?   @db.Text
  wizardStep            Int       @default(1)
  wizardCompleted       Boolean   @default(false)
  loopEnabled           Boolean   @default(false)
  loopInterval          String    @default("24h")
  loopAgents            String    @default("ads,compliance")
  lastLoopRunAt         DateTime?
  launchedAt            DateTime?
  launchCheckpoint      String    @default("DRAFT") // DRAFT | CREATING_GOOGLE_ADS | SUCCESS_GOOGLE_ADS | CREATING_META_ADS | SUCCESS
  launchIdempotencyKey  String?

  // Estado do produto Low Ticket. draftData é editável por agentes em background;
  // activeData só muda após aprovação explícita do usuário.
  productType String?
  draftData   Json?
  activeData  Json?

  // Metadados de Experimentos A/B (Google Ads Experiments)
  isExperiment             Boolean @default(false)
  experimentId             String?
  experimentStatus         String? // SETUP | SCHEDULED | RUNNING | PROMOTED | GRADUATED | ENDED
  experimentTrafficSplit   Int     @default(50)
  baseCampaignId           String?
  googleTrialCampaignId    String?
  experimentVariationType  String? // PRESELL | ADS_COPY | BID_STRATEGY
  experimentVariationValue String? @db.Text

  createdAt                 DateTime                           @default(now())
  updatedAt                 DateTime                           @updatedAt
  user                      User                               @relation(fields: [userId], references: [id], onDelete: Cascade)
  productResearch           ProductResearch?                   @relation(fields: [productResearchId], references: [id], onDelete: SetNull)
  checklists                CampaignChecklist[]
  keywords                  Keyword[]
  dailyLogs                 DailyLog[]
  decisions                 CampaignDecision[]
  atpSearches               AtpSearch[]
  loopRuns                  LoopRun[]
  bridgePageRecommendations BridgePageStrategyRecommendation[]
  presells                  Presell[]
  googleAdsExperiments      GoogleAdsExperiment[]
  marketResearches          MarketResearch[]
  brandKits                 BrandKit[]
  offerDesigns              OfferDesign[]
  claimLedger               ClaimLedgerEntry[]
  contentArchitectures      ContentArchitecture[]
  copyQaReports             CopyQaReport[]
  visualSystems             VisualSystem[]
  launchPlans               LaunchPlan[]
  channelLaunches           ChannelLaunch[]
  globalKnowledgeInsights   GlobalKnowledgeInsight[]
  aiCostLogs                AICostLog[]

  @@index([userId, status])
  @@index([userId, platform])
  @@index([productResearchId])
}

model AICostLog {
  id               String    @id @default(cuid())
  campaignId       String?
  campaign         Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  model            String
  provider         String
  promptTokens     Int
  completionTokens Int
  costUsd          Float
  purpose          String
  createdAt        DateTime  @default(now())

  @@index([campaignId])
  @@index([campaignId, createdAt])
  @@index([provider, model])
  @@index([createdAt])
}

model GlobalKnowledgeInsight {
  id        String     @id @default(cuid())
  videoUrl  String     @unique
  title     String
  channel   String?
  vertical  String?
  summary   String     @db.Text
  insights  Json
  tags      String[]
  createdAt DateTime   @default(now())
  campaigns Campaign[]

  @@index([vertical])
  @@index([createdAt])
  @@index([tags], type: Gin)
}

model CampaignChecklist {
  id               String    @id @default(cuid())
  campaignId       String
  step             Int
  itemKey          String
  itemLabel        String
  isCritical       Boolean   @default(false)
  isChecked        Boolean   @default(false)
  checkedAt        DateTime?
  verificationType String    @default("self_attested")
  note             String?   @db.Text
  campaign         Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, step, itemKey])
  @@index([campaignId])
}

model Keyword {
  id             String    @id @default(cuid())
  campaignId     String?
  userId         String
  keyword        String
  layer          String    @default("A")
  matchType      String    @default("phrase")
  cpcEstimate    Float     @default(0)
  relevanceScore Int       @default(3)
  isSelected     Boolean   @default(false)
  status         String    @default("ativa")
  clicks         Int       @default(0)
  cpcReal        Float     @default(0)
  conversions    Int       @default(0)
  createdAt      DateTime  @default(now())
  campaign       Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([campaignId])
}

model DailyLog {
  id          String   @id @default(cuid())
  campaignId  String
  userId      String
  logDate     DateTime
  impressions Int      @default(0)
  spend       Float    @default(0)
  clicks      Int      @default(0)
  hops        Int      @default(0)
  conversions Int      @default(0)
  revenue     Float    @default(0)
  refunds     Float    @default(0)
  network     String?
  offerName   String?
  vertical    String?
  geo         String?
  channel     String?
  funnel      String?
  decision    String?
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([campaignId, logDate])
  @@index([campaignId])
  @@index([userId])
}

model CampaignDecision {
  id         String   @id @default(cuid())
  campaignId String
  userId     String
  decision   String
  rationale  String?  @db.Text
  createdAt  DateTime @default(now())
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}

model Integration {
  id          String   @id @default(cuid())
  userId      String
  serviceName String
  fieldName   String
  fieldValue  String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, serviceName, fieldName])
  @@index([userId, serviceName])
}

model Offer {
  id                String    @id @default(cuid())
  userId            String
  offerId           String
  network           String
  name              String
  vertical          String
  geoAllowed        String    @default("US")
  payoutCommission  String    @default("")
  model             String    @default("CPA")
  gravityEpcRef     String    @default("")
  upsells           String    @default("Não")
  trademarkBidding  String    @default("Proibido")
  googleAllowed     String    @default("")
  funnelRecommended String    @default("Bridge")
  vendorTermsOk     Boolean   @default(false)
  hopLink           String?   @db.Text
  breakevenCpc      Float     @default(0)
  status            String    @default("Teste")
  testStartDate     DateTime?
  result            String?
  notes             String?   @db.Text
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, offerId])
  @@index([userId])
}

model TestResult {
  id           String    @id @default(cuid())
  userId       String
  testId       String
  campaignId   String
  network      String
  offerName    String
  hypothesis   String?   @db.Text
  budgetTest   Float     @default(0)
  minClicks    Int       @default(0)
  actualSpend  Float     @default(0)
  conversions  Int       @default(0)
  revenue      Float     @default(0)
  epc          Float     @default(0)
  avgCpc       Float     @default(0)
  breakevenCpc Float     @default(0)
  result       String    @default("PENDENTE")
  nextStep     String?
  learning     String?   @db.Text
  startDate    DateTime?
  endDate      DateTime?
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, testId])
  @@index([userId])
}

model AtpSearch {
  id             String    @id @default(cuid())
  userId         String
  campaignId     String?
  keyword        String
  language       String    @default("en")
  region         String    @default("us")
  provider       String    @default("gweb")
  parentSearchId String?
  searchId       String?
  status         String    @default("loading")
  creditCharged  Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign       Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([campaignId])
}

model LoopRun {
  id          String   @id @default(cuid())
  campaignId  String
  userId      String
  trigger     String   @default("manual")
  decision    String   @default("SEM_DADOS")
  triggers    Json?
  agentsRun   Json?
  economics   Json?
  llmSummary  String?  @db.Text
  totalTokens Int      @default(0)
  error       String?  @db.Text
  createdAt   DateTime @default(now())
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([userId, createdAt])
}

model AgentRun {
  id               String   @id @default(cuid())
  userId           String
  agent            String
  provider         String   @default("")
  model            String   @default("")
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  costUsd          Float    @default(0)
  keySource        String   @default("platform") // platform = chave global (a pagar ao admin) | byok = chave própria do usuário
  durationMs       Int      @default(0)
  success          Boolean  @default(true)
  error            String?  @db.Text
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, agent])
  @@index([userId, createdAt])
}

// Fechamento mensal do uso de agentes com chave da plataforma: o admin gera a cobrança
// do período e marca como paga quando o usuário quitar por fora do sistema.
model UsagePayment {
  id        String    @id @default(cuid())
  userId    String
  period    String // "YYYY-MM"
  amountUsd Float     @default(0)
  status    String    @default("PENDENTE") // PENDENTE | PAGO
  notes     String?   @db.Text
  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, period])
  @@index([userId])
}

model KnowledgeBaseSearch {
  id        String   @id @default(cuid())
  userId    String
  query     String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum SalesPageType {
  VSL
  DIRECT
  QUIZ
  LEAD_GEN
  OTHER
}

enum BridgePageType {
  POGO
  ADVERTORIAL
  QUIZ_FUNNEL
  LEAD_GEN_PAGE
  INTERSTITIAL
  OTHER
}

// Tipo de produto/estratégia usado pela pesquisa de mercado.
enum ProductType {
  AFFILIATE
  PROPRIETARY_LOW_TICKET
  MENTORSHIP
}

model ProductResearch {
  id                        String                             @id @default(cuid())
  userId                    String
  name                      String
  network                   String                             @default("clickbank")
  vertical                  String                             @default("")
  gravity                   Float?
  avgPayout                 Float?
  commissionPct             String                             @default("")
  conversionRate            String                             @default("")
  rebill                    Boolean                            @default(false)
  score                     Int                                @default(0)
  riskLevel                 String                             @default("medio")
  source                    String                             @default("ia")
  summary                   String?                            @db.Text
  tags                      Json?
  keywords                  Json?
  strategy                  Json?
  compliance                Json?
  hopLink                   String?                            @db.Text
  affiliatePageUrl          String?                            @db.Text
  assetsUrl                 String?                            @db.Text
  vendorPageUrl             String?                            @db.Text
  affiliateInsights         Json?
  status                    String                             @default("novo")
  chosenKeyword             String                             @default("")
  salesPageType             SalesPageType?
  avgConversionRate         Float?
  avgEpc                    Float?
  confirmedAt               DateTime?
  createdAt                 DateTime                           @default(now())
  updatedAt                 DateTime                           @updatedAt
  user                      User                               @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaigns                 Campaign[]
  bridgePageRecommendations BridgePageStrategyRecommendation[]
  marketIntelSnapshots      MarketIntelSnapshot[]
  marketResearch            MarketResearch?
  brandKits                 BrandKit[]
  offerDesigns              OfferDesign[]
  claimLedger               ClaimLedgerEntry[]
  contentArchitectures      ContentArchitecture[]
  copyQaReports             CopyQaReport[]
  visualSystems             VisualSystem[]
  launchPlans               LaunchPlan[]

  @@unique([userId, name])
  @@index([userId])
}

// Inteligência de concorrência e pesquisa de mercado produzida pelo ad-scout-oracle.
model MarketResearch {
  id              String      @id @default(cuid())
  userId          String
  productId       String?     @unique
  campaignId      String?
  query           String      @db.Text
  productType     ProductType @default(AFFILIATE)
  adCount         Int         @default(0)
  avgPrice        Float       @default(0.0)
  competitors     Json        @default("[]")
  audiencePain    Json        @default("[]")
  anglesSuggested Json        @default("[]")
  analyzedClaims  Json        @default("[]")
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  productResearch ProductResearch? @relation(fields: [productId], references: [id], onDelete: SetNull)
  campaign        Campaign?        @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([productId])
  @@index([campaignId])
}

model BridgePageStrategyRecommendation {
  id              String          @id @default(cuid())
  productId       String
  campaignId      String?
  recommendedType BridgePageType
  reasoning       String          @db.Text
  confidenceScore Float
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  productResearch ProductResearch @relation(fields: [productId], references: [id], onDelete: Cascade)
  campaign        Campaign?       @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([campaignId])
}

// Inteligência de mercado externa (concorrentes reais promovendo o mesmo produto/vertical) —
// nunca guarda texto pra copiar literal, só padrões estruturais de referência (mesma disciplina
// de elementosPresellReferencia em lib/presell.ts).
model MarketIntelSnapshot {
  id              String           @id @default(cuid())
  userId          String
  productId       String?
  vertical        String
  query           String           @db.Text
  angles          Json?
  pageTypesSeen   Json?
  sources         Json?
  fetchedAt       DateTime         @default(now())
  createdAt       DateTime         @default(now())
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  productResearch ProductResearch? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([productId])
}

model Presell {
  id               String    @id @default(cuid())
  userId           String
  productId        String?
  campaignId       String?
  slug             String    @unique
  title            String
  productName      String
  hopLink          String    @db.Text
  trackingId       String    @default("")
  angle            String    @default("review")
  pageType         String    @default("advertorial")
  popupGate        Boolean   @default(false)
  videoUrl         String    @default("")
  customCode       String    @default("") @db.Text
  variantGroupId   String?   @db.Text
  geo              String    @default("US")
  language         String    @default("en")
  html             String    @db.Text
  content          Json?
  status           String    @default("rascunho")
  views            Int       @default(0)
  ctaClicks        Int       @default(0)
  googleAdsId      String    @default("")
  publishTarget    String    @default("railway")
  wpDomain         String    @default("")
  publishedUrl     String    @default("")
  complianceScore  Int?
  complianceIssues Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign         Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([campaignId])
}

model ChecklistLearning {
  id              String   @id @default(cuid())
  userId          String
  itemKey         String
  scope           String
  vertical        String?
  channel         String?
  platform        String?
  pageType        String?
  problem         String   @db.Text
  correction      String   @db.Text
  appliesGlobally Boolean  @default(true)
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, itemKey])
  @@index([vertical, channel])
}

// Experimentos A/B nativos do Google Ads (system-managed SEARCH_CUSTOM), modelagem dedicada.
// Substitui os campos-protótipo isExperiment/experimentId/... em Campaign (mantidos por ora
// como legado — ver plano .hermes/plans/2026-07-29_023051-google-ads-experiments-wizard.md
// seção 4 "Compatibilidade com os campos já adicionados a Campaign": backfill idempotente,
// dual-read temporário, remoção do legado só em migração posterior após auditoria de produção.
// Nomenclatura canônica da variação nesta modelagem nova: "PRESELL_URL" (o campo legado
// Campaign.experimentVariationType usa "PRESELL" no comentário — drift documentado, não
// corrigido no legado propositalmente; o backfill normaliza PRESELL -> PRESELL_URL).
model GoogleAdsExperiment {
  id                    String    @id @default(cuid())
  userId                String
  campaignId            String
  googleExperimentId    String?
  resourceName          String?
  name                  String
  type                  String    @default("SEARCH_CUSTOM")
  status                String    @default("SETUP") // SETUP | SCHEDULED | RUNNING | PROMOTED | GRADUATED | ENDED | ERROR (string tolerante a novos estados da API)
  syncEnabled           Boolean   @default(true)
  trafficAllocationType String    @default("SEARCH_CUSTOM")
  startDate             DateTime?
  endDate               DateTime?
  variationType         String    @default("PRESELL_URL") // PRESELL_URL no MVP; ADS_COPY/BID_STRATEGY fora de escopo
  variationConfig       Json?
  budgetRecommendation  Json?
  decisionPolicy        Json?
  lastSyncedAt          DateTime?
  lastMetricsAt         DateTime?
  lastError             String?   @db.Text
  idempotencyKey        String
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user            User                                @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign        Campaign                            @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  arms            GoogleAdsExperimentArm[]
  operations      GoogleAdsExperimentOperation[]
  metricSnapshots GoogleAdsExperimentMetricSnapshot[]

  @@unique([userId, idempotencyKey])
  @@unique([userId, googleExperimentId])
  @@index([userId, status])
  @@index([campaignId])
}

// Braço de controle ou tratamento de um GoogleAdsExperiment. Restrição lógica (aplicada em
// app, não em constraint de banco — ver plano seção 4/5): exatamente um controle por
// experimento e soma dos trafficSplit = 100; MVP sempre 2 braços.
model GoogleAdsExperimentArm {
  id                           String   @id @default(cuid())
  experimentId                 String
  name                         String
  isControl                    Boolean  @default(false)
  trafficSplit                 Int
  googleArmId                  String?
  resourceName                 String?
  inDesignCampaignResourceName String?
  servedCampaignResourceName   String?
  googleCampaignId             String?
  localPresellId               String?
  finalUrl                     String?  @db.Text
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  experiment GoogleAdsExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)

  @@unique([experimentId, name])
  @@index([experimentId])
}

// Operações assíncronas do Google Ads (ScheduleExperiment/PromoteExperiment são long-running
// operations). operationName é o identificador retornado pela API para poll de status.
model GoogleAdsExperimentOperation {
  id            String    @id @default(cuid())
  experimentId  String
  operationType String // SCHEDULE | PROMOTE
  operationName String    @unique
  status        String    @default("PENDING") // PENDING | DONE | FAILED
  errorCode     String?
  errorMessage  String?   @db.Text
  errors        Json?
  startedAt     DateTime  @default(now())
  completedAt   DateTime?

  experiment GoogleAdsExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)

  @@index([experimentId])
  @@index([status])
}

// Snapshot diário de métricas de controle/tratamento + estatística (uplift/p-value/margin of
// error) vinda do recurso `experiment` da Google Ads API. costMicros armazenado como Float
// (não Int) porque valores em micros ultrapassam facilmente o range de Int32 do Postgres.
model GoogleAdsExperimentMetricSnapshot {
  id                       String   @id @default(cuid())
  experimentId             String
  snapshotDate             DateTime
  controlImpressions       Int      @default(0)
  controlClicks            Int      @default(0)
  controlCostMicros        Float    @default(0)
  controlConversions       Float    @default(0)
  controlConversionValue   Float    @default(0)
  treatmentImpressions     Int      @default(0)
  treatmentClicks          Int      @default(0)
  treatmentCostMicros      Float    @default(0)
  treatmentConversions     Float    @default(0)
  treatmentConversionValue Float    @default(0)
  statistics               Json? // { metrica: { pointEstimate, marginOfError, pValue } }
  sourcePayload            Json?
  createdAt                DateTime @default(now())

  experiment GoogleAdsExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)

  @@unique([experimentId, snapshotDate])
  @@index([experimentId])
}

// Fila de sincronização pro Hermes/Obsidian: produção (Railway) não tem o filesystem local
// onde o Hermes real e o vault Obsidian vivem, então em vez de tentar escrever arquivo (que
// já era no-op silencioso lá), grava aqui. Um processo rodando na máquina do usuário
// (scripts_local/process_outbox.js) faz polling e escreve o arquivo de verdade local.
model HermesOutboxEntry {
  id          String    @id @default(cuid())
  type        String
  payload     Json
  targetPath  String?
  status      String    @default("pending")
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([status])
}

